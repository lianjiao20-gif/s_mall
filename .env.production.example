# With a domain: SITE_ADDRESS=shop.example.com (Caddy enables HTTPS)
# Without a domain: SITE_ADDRESS=http://YOUR_SERVER_IP
SITE_ADDRESS=
DB_NAME=smalldemo
DB_USER=smalldemo
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_SECRET=

# TCR deployment only. Use the same unique version suffix for both images.
# API_IMAGE=ccr.ccs.tencentyun.com/dev-s-mall-image/s_mall_api:VERSION
# WEB_IMAGE=ccr.ccs.tencentyun.com/dev-s-mall-image/s_mall_web:VERSION
API_IMAGE=
WEB_IMAGE=
